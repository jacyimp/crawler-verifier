{
    "name": "jacyimp/crawler-verifier",
    "description": "Verify that web crawlers are actually who they claim to be.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "crawler",
        "bot",
        "crawler-verification",
        "googlebot",
        "seo"
    ],
    "authors": [
        {
            "name": "JacyImp"
        }
    ],
    "require": {
        "php": "^8.2",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "2.0"
    },
    "autoload": {
        "psr-4": {
            "JacyImp\\CrawlerVerifier\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JacyImp\\CrawlerVerifier\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
